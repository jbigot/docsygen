{{- /* Two versions of the sample's XML, for the build cases of builds/versions-*.yaml: old, and
       1.0, the latest. */ -}}
{{- partial "docsygen/adapter.html" (dict "store" . "dir" "doxygen/sample" "version" "old" "path" "old") -}}
{{- partial "docsygen/adapter.html" (dict "store" . "dir" "doxygen/sample" "version" "1.0" "path" "1.0" "latest" true) -}}
