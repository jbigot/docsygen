{{- /* The main page alone as the version's section, placed before a namespace below it, in two
       versions. */ -}}
{{- range slice (dict "version" "old") (dict "version" "1.0" "latest" true) -}}
  {{- partial "docsygen/adapter.html" (merge . (dict "store" $ "dir" "doxygen/sample" "path" "ref/:version" "select" "" "children" false)) -}}
  {{- partial "docsygen/adapter.html" (merge . (dict "store" $ "dir" "doxygen/sample" "path" "ref/:version/api" "select" "api/demo")) -}}
{{- end -}}
