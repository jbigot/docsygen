{{- /* Two calls of one version that read two XML directories. */ -}}
{{- partial "docsygen/adapter.html" (dict "store" . "dir" "doxygen/sample" "version" "1.0" "path" ":version" "select" "pages" "latest" true) -}}
{{- partial "docsygen/adapter.html" (dict "store" . "dir" "doxygen/sample-c" "version" "1.0" "path" "c/:version" "select" "api" "latest" true) -}}
