{
  "name": "docsygen-example-site",
  "version": "0.0.0",
  "description": "Example site of docsygen: docsy-example with docsygen added.",
  "repository": "github:jbigot/docsygen",
  "homepage": "https://jbigot.github.io/docsygen/",
  "author": "Docsy Authors",
  "license": "Apache-2.0",
  "bugs": "https://github.com/jbigot/docsygen/issues",
  "workspaces": [
    "packages/hugoautogen"
  ],
  "scripts": {
    "_hugo-dev": "npm run _hugo -- -e dev --logLevel info -DFE",
    "_hugo": "hugo --cleanDestinationDir",
    "_serve": "npm run _hugo-dev -- --minify serve --renderToMemory",
    "build:preview": "npm run _hugo-dev -- --minify --baseURL \"${DEPLOY_PRIME_URL:-/}\"",
    "build:production": "npm run _hugo -- --minify",
    "build": "hugo --cleanDestinationDir --baseURL \"${BASE_URL:-http://localhost}\"",
    "clean": "rm -Rf public/* resources",
    "serve": "npm run _serve"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "hugo-extended": "0.169.0",
    "postcss-cli": "12.0.0",
    "rtlcss": "4.3.0",
    "sass-embedded": "1.105.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11.18.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "hugo-extended@0.169.0": true
  },
  "private": true
}
