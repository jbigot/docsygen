</entry><entry thead="no" align='left'><para>see <ulink url="https://cmake.org/cmake/help/v3.19/module/GNUInstallDirs.html">GNUInstallDirs</ulink>  </para>
</entry><entry thead="no" align='left'><para>documentation root  </para>
</entry></row>
<row>
<entry thead="no" align='left'><para><computeroutput>CMAKE_INSTALL_INCLUDEDIR</computeroutput>  </para>
</entry><entry thead="no" align='left'><para>see <ulink url="https://cmake.org/cmake/help/v3.19/module/GNUInstallDirs.html">GNUInstallDirs</ulink>  </para>
</entry><entry thead="no" align='left'><para>C header files  </para>
</entry></row>
<row>
<entry thead="no" align='left'><para><computeroutput>CMAKE_INSTALL_LIBDIR</computeroutput>  </para>
</entry><entry thead="no" align='left'><para>see <ulink url="https://cmake.org/cmake/help/v3.19/module/GNUInstallDirs.html">GNUInstallDirs</ulink>  </para>
</entry><entry thead="no" align='left'><para>object code libraries  </para>
</entry></row>
