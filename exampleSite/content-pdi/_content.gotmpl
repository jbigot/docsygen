{{- /* PDI's documentation in four sections per version, each with its own sidebar: the user
       documentation at /docs/<version>/ (the guide's pages and the C API's topics, and
       docs/latest/docsygen.md), the plugins at /plugins/<version>/, the plugin developer
       documentation at /plugin-dev/<version>/ (how to create a plugin, the namespaces and the
       deprecated list among them), and the tutorial at /tutorial/<version>/, from the latest
       release only. PDI's main page, About, has no page: the sidebars replace its lists. */ -}}
{{- $user := slice "page:Installation" "page:PDI_usage" "page:Concepts" "page:First_steps" "page:PDI_example"
    "page:Specification_tree_ref" "topics" "page:FAQ" -}}
{{- range slice (dict "dir" "doxygen/pdi" "version" "main" "user" $user)
    (dict "dir" "doxygen/pdi-1.12" "version" "1.12" "latest" true "user" $user)
    (dict "dir" "doxygen/pdi-1.7" "version" "1.7" "user" (slice "page:Installation" "page:PDI_usage" "page:Concepts"
      "page:First_steps" "page:Specification_tree_ref" "topics" "page:FAQ")
      "plugins" (dict "children" false)) -}}
  {{- $v := dict "store" $ "dir" .dir "version" .version "latest" (.latest | default false) -}}
  {{- range $i, $select := .user -}}
    {{- $slug := cond (eq $select "topics") "c-api" (lower (strings.TrimPrefix "page:" $select)) -}}
    {{- $title := cond (eq $select "topics") "C API Reference" "" -}}
    {{- $call := merge $v (dict "path" (printf "docs/:version/%s" $slug) "select" $select "weight" (mul (add $i 1) 10)) -}}
    {{- with $title -}}{{- $call = merge $call (dict "title" .) -}}{{- end -}}
    {{- partial "docsygen/adapter.html" $call -}}
  {{- end -}}
  {{- /* In 1.7, how to create a plugin is a subpage of the plugins' page too. */ -}}
  {{- partial "docsygen/adapter.html" (merge $v (dict "path" "plugins/:version" "select" "page:Plugins") (.plugins | default dict)) -}}
  {{- partial "docsygen/adapter.html" (merge $v (dict "path" "plugin-dev/:version/how_to_create_plugin" "select" "page:how_to_create_plugin"
      "weight" 10)) -}}
  {{- partial "docsygen/adapter.html" (merge $v (dict "path" "plugin-dev/:version/api" "select" "api" "title" "Plugin API reference" "weight" 20)) -}}
  {{- /* 1.7 has no deprecated list. */ -}}
  {{- if ne .version "1.7" -}}
    {{- partial "docsygen/adapter.html" (merge $v (dict "path" "plugin-dev/:version/api/deprecated" "select" "page:deprecated")) -}}
  {{- end -}}
  {{- if .latest -}}
    {{- partial "docsygen/adapter.html" (merge $v (dict "path" "tutorial/:version" "select" "page:Hands_on")) -}}
  {{- end -}}
{{- end -}}
